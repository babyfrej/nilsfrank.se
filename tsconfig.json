{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"types": ["bun"],
		"sourceMap": true,
		"noPropertyAccessFromIndexSignature": true,
		"verbatimModuleSyntax": true,
		"noUncheckedSideEffectImports": true,
		"skipLibCheck": true
	},
	"include": [".astro/types.d.ts", "worker-configuration.d.ts", "src/**/*"]
}
