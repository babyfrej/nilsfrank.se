datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma"
}

model Event {
  id String @id @default(uuid())

  details  EventDetails?
  wishlist Wishlist[]
  slots    EventSlot[]
}

model EventDetails {
  id          String    @id @unique
  name        String
  description String?
  location    String?
  osaAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  event   Event         @relation(fields: [id], references: [id])
  contact EventContact?
}

model EventSlot {
  id    String   @id @default(uuid())
  start DateTime
  end   DateTime
  seats Int

  guests  Guests[]
  Event   Event?   @relation(fields: [eventId], references: [id])
  eventId String?
}

model EventContact {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  message   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  event EventDetails @relation(fields: [id], references: [id])
}

model Guests {
  email     String
  name      String
  attending Boolean
  adults    Int
  children  Int
  notes     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reservationId String
  reservation   EventSlot @relation(fields: [reservationId], references: [id])

  @@id([email, reservationId])
}

model Wishlist {
  id          String  @id @default(uuid())
  title       String
  description String?
  href        String?
  image       String?
  price       Int?
  hero        Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  claimType Int             @default(0)
  claims    WishlistClaim[]
}

model WishlistClaim {
  email      String
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id])

  amount Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@id([email, wishlistId])
}
